# ---------------------------------------------------------------------------
# AVIP on-prem production config — EXAMPLE.
# Copy to `.env.prod` on the server and fill in real values. `.env.prod` is
# gitignored and read by docker-compose.prod.yml (env_file, required: false).
# Leaving everything at these defaults runs fully offline on the mock provider.
# ---------------------------------------------------------------------------

# Host port the frontend (nginx) is published on. Browse to http://<host>:<port>.
AVIP_HTTP_PORT=8080

# Source-comparison simulator. Keep false in prod (it's an unbounded demo feed).
AVIP_SC_SIMULATOR=false

# TPI multimodal provider: 'mock' (default, deterministic, no network) or
# 'openai' (real vision analysis — requires OPENAI_API_KEY + outbound HTTPS).
AVIP_TPI_LLM_PROVIDER=mock

# Existing inspection Vision LLM (optional; unrelated to TPI). 'true' needs a key.
AVIP_VISION_LLM=false

# OpenAI credentials — ONLY needed if a provider above is set to 'openai'.
# On an air-gapped/on-prem network without outbound internet, leave blank and
# keep providers on 'mock'.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
